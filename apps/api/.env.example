# --- Database ---
DATABASE_URL="postgresql://famstory:famstory@localhost:5432/famstory?schema=public"

# --- Queues and cache ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""

# --- File storage (S3-compatible, EU region) ---
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET="famstory-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Push ---
FCM_SERVICE_ACCOUNT_JSON=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.famstory.app"

# --- Payments ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
APPLE_SHARED_SECRET=""
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""

# --- Monitoring (an EU region is a requirement) ---
SENTRY_DSN=""
SENTRY_REGION="eu"

# --- Security ---
# The salt for hashing IPs in the audit log. Without it an IP is recoverable.
AUDIT_IP_SALT="change-me"
CORS_ORIGINS="http://localhost:8081"

PORT=3000
NODE_ENV=development
