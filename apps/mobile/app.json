{
  "expo": {
    "name": "FamStory",
    "slug": "famstory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "famstory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "lv.famstory.app",
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lv.famstory.app",
      "adaptiveIcon": {
        "backgroundColor": "#234E42",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#16150E",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FamStory uses your photos so that you can add them to your family's events and profiles.",
          "cameraPermission": false,
          "microphonePermission": "FamStory uses the microphone to record voice notes for your family's events."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "FamStory uses the microphone to record voice notes for your family's events.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "locales": {
      "lv": "./locales/lv.json",
      "en": "./locales/en.json"
    }
  }
}
