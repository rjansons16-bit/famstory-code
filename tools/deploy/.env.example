# tools/deploy/.env - the server's secrets. Copy this file to .env next to it
# and fill every line. The .env is ignored by git and by Docker's build.
#
# Make each secret with:   openssl rand -base64 48
# Never reuse the laptop's values: whoever has seen those has seen these.

# The address the family will type, and where Let's Encrypt writes about it.
DOMAIN=famstory.lv
ACME_EMAIL=you@example.lv
# Where "Write to us" and the account-deletion page send people. The terms and
# the privacy policy name the same mailbox (docs/legal/facts.json).
SUPPORT_EMAIL=support@famstory.lv

# The database password. Only the API and the migrations use it.
POSTGRES_PASSWORD=

# Signs sessions. Changing it signs everybody out.
JWT_SECRET=
# Signs photograph and calendar addresses. Changing it breaks every calendar
# subscription and every open photograph link (they are re-made on the next
# visit; calendar feeds have to be added again).
MEDIA_SIGNING_SECRET=
# Salts the hashed addresses in the audit log.
AUDIT_IP_SALT=

# Only if the web app is ever served from another origin than DOMAIN.
CORS_ORIGINS=

# --- Filled once the developer accounts exist (docs/12-LAUNCH-RUNBOOK.md) ---

# Premium. RevenueCat, Project settings, API keys: the secret key (sk_...).
REVENUECAT_SECRET_KEY=
# RevenueCat, Integrations, Webhooks: the "Authorization header value" set
# there, exactly - make it with openssl rand -base64 48 and paste it in both.
REVENUECAT_WEBHOOK_AUTH=

# Which app may open the site's links. Apple: Membership details, Team ID
# (ten characters). Google: Play Console, Test and release, App integrity,
# App signing key certificate, the SHA-256 fingerprint (AB:CD:...).
# The same Team ID signs the pushes to iPhones (APNS_* below).
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=

# "Forgot your password?" by email. Any SMTP provider - the mailbox's own if
# it sends, or a transactional one in the EU - named in the privacy policy as
# {{mailer}} (docs/legal/facts.json). Left empty, the app offers the family
# admin's link instead.
#   SMTP_URL=smtps://user:password@smtp.provider.example:465
SMTP_URL=
MAIL_FROM=FamStory <support@famstory.lv>

# Pushes to iPhones: Certificates, Identifiers & Profiles, Keys, "+", with
# Apple Push Notifications service. The key's ID (ten characters), and the
# downloaded .p8 file in base64 on one line:  base64 -w0 AuthKey_XXXX.p8
APNS_KEY_ID=
APNS_KEY=
# Pushes to Android: Firebase console, Project settings, Service accounts,
# Generate new private key - the JSON file in base64 on one line.
FCM_SERVICE_ACCOUNT=

# --- Filled on release day (docs/12-LAUNCH-RUNBOOK.md, section 8) ---

# The app's pages in the stores. The welcome page shows a button for each one
# that is set, instead of "coming soon". Rebuild the web image after setting:
#   docker compose -f tools/deploy/docker-compose.yml up -d --build web
# https://apps.apple.com/app/id<Apple ID> - the number App Store Connect shows
# under the app's App Information, "Apple ID".
APP_STORE_URL=
# The package name decides it: https://play.google.com/store/apps/details?id=lv.famstory.app
PLAY_STORE_URL=
